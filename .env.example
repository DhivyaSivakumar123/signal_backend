# ==============================================================================
# JWT Configuration
# ==============================================================================
# A secure 256-bit key for JWT signatures (must be at least 32 characters long)
SIGNAL_JWT_SECRET=super_secret_key_for_signal_backend_development_must_be_32_bytes_long
# Optional overrides (in milliseconds):
# SIGNAL_JWT_ACCESS_EXPIRATION=900000     # 15 mins (default)
# SIGNAL_JWT_REFRESH_EXPIRATION=604800000 # 7 days (default)

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/signal_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ==============================================================================
# Redis Configuration (Idempotency, Rate Limiting, and JWT Blacklist)
# ==============================================================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ==============================================================================
# AWS Configuration (LocalStack SQS Emulator)
# ==============================================================================
SPRING_CLOUD_AWS_CREDENTIALS_ACCESS_KEY=test
SPRING_CLOUD_AWS_CREDENTIALS_SECRET_KEY=test
SPRING_CLOUD_AWS_REGION_STATIC=us-east-1
SPRING_CLOUD_AWS_ENDPOINT=http://localhost:4566

# ==============================================================================
# Microservice URL Routing (Gateway Configuration)
# ==============================================================================
SIGNAL_FRONTEND_URL=http://localhost:4200
AUTH_SERVICE_URL=http://localhost:8081
INTEGRATION_SERVICE_URL=http://localhost:8082
SCORING_SERVICE_URL=http://localhost:8083
TRIAGE_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_URL=http://localhost:8085

# ==============================================================================
# LLM Urgency Scorer Configuration
# ==============================================================================
# Choose provider: "mock" (default keyword-regex), "openai" (GPT-4o), or "claude" (Claude 3.5 Sonnet)
SIGNAL_SCORING_PROVIDER=mock

# OpenAI Settings (only required if provider is set to "openai")
SIGNAL_SCORING_OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude Settings (only required if provider is set to "claude")
SIGNAL_SCORING_CLAUDE_API_KEY=your_claude_api_key_here

# ==============================================================================
# OAuth2 Provider Registrations (auth-service)
# ==============================================================================
# Google Credentials (Prefix with "dummy-" to auto-bypass in dev mode)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=dummy-google-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=dummy-google-client-secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI={baseUrl}/oauth2/callback/google

# Microsoft Credentials (Prefix with "dummy-" to auto-bypass in dev mode)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_MICROSOFT_CLIENT_ID=dummy-microsoft-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_MICROSOFT_CLIENT_SECRET=dummy-microsoft-client-secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_MICROSOFT_REDIRECT_URI={baseUrl}/oauth2/callback/microsoft
